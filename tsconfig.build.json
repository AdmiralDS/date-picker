{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "jsx": "react-jsx",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "sourceMap": true
  },
  "extends": "./tsconfig.json",
  "include": ["lib"],
  "exclude": ["lib/**/*.test.tsx", "lib/**/__snapshots__/**", "lib/components/*RangeDoublePickerCalendar"]
}
