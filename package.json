{
  "name": "@admiral-ds/date-picker",
  "description": "Admiral DS DatePicker",
  "version": "0.0.4",
  "author": "Admiral DS team",
  "repository": {
    "type": "git",
    "url": "https://github.com/AdmiralDS/date-picker"
  },
  "scripts": {
    "check:full": "npm run format && npm run typecheck && npm run test && npm run build:storybook && npm run build:lib && npm run test:package",
    "storybook": "storybook dev -p 6006",
    "test:storybook": "test-storybook",
    "release": "standard-version",
    "prepare": "npm run build:lib",
    "clean": "node scripts/clean.mjs",
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eslint": "eslint src lib .storybook",
    "eslint:fix": "npm run eslint -- --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "format": "npm run prettier && npm run eslint",
    "format:fix": "npm run prettier:fix && npm run eslint:fix",
    "preview": "vite preview",
    "preview:storybook": "vite preview --outDir docs/current",
    "test:storybook:ci": "start-server-and-test \"npm run preview:storybook -- --host 127.0.0.1\" http://127.0.0.1:4173 \"npm run test:storybook -- --ci --url http://127.0.0.1:4173\"",
    "test:package": "node scripts/verify-package.mjs",
    "build:app": "tsc -b && vite build",
    "build:storybook": "storybook build --disable-telemetry --output-dir docs/current",
    "build:lib": "npm run typecheck && npm run clean && vite -c vite.build.config.ts build",
    "release:patch": "standard-version --release-as patch",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.20.0",
    "@storybook/addon-essentials": "^8.3.5",
    "@storybook/addon-interactions": "^8.6.4",
    "@storybook/addon-themes": "^8.3.5",
    "@storybook/blocks": "^8.3.5",
    "@storybook/react": "^8.3.5",
    "@storybook/react-vite": "^8.3.5",
    "@storybook/test": "^8.3.5",
    "@storybook/test-runner": "^0.22.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vanilla-extract/css": "^1.16.0",
    "@vanilla-extract/dynamic": "^2.1.2",
    "@vanilla-extract/vite-plugin": "^4.0.16 || ^5",
    "@vitejs/plugin-react": "^4.3.2",
    "babel-plugin-styled-components": "^2.1.4",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "eslint-plugin-storybook": "^0.12.0",
    "globals": "^15.14.0 || ^16",
    "happy-dom": "^15.7.4 || ^16 || ^17",
    "prettier": "^3.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-tiny-popover": "^8.1.2",
    "standard-version": "^9.5.0",
    "start-server-and-test": "^3.0.12",
    "storybook": "^8.3.5",
    "storybook-dark-mode": "^4.0.2",
    "typescript": "^5",
    "typescript-eslint": "^8.56.1",
    "typescript-plugin-css-modules": "^5.1.0",
    "vite": "^5.4.8 || ^6.0.2",
    "vite-plugin-dts": "^4.2.3",
    "vite-plugin-lib-inject-css": "^2.1.1",
    "vite-plugin-svgr": "^4.2.0",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^2.1.2 || ^3"
  },
  "peerDependencies": {
    "@admiral-ds/fonts": "^2.0.0",
    "@admiral-ds/icons": "^4.3.3",
    "@admiral-ds/react-ui": "^8.0.0",
    "@admiral-ds/web": "^0.0.4",
    "@maskito/core": "^2.4.0 || ^3",
    "@maskito/kit": "^2.4.0 || ^3",
    "@maskito/react": "^2.4.0 || ^3",
    "dayjs": "^1.0.0",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "styled-components": "^5 || ^6.1.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/main.d.ts",
      "import": "./dist/esm/main.js",
      "require": "./dist/cjs/main.cjs"
    }
  },
  "main": "./dist/cjs/main.cjs",
  "types": "./dist/types/main.d.ts",
  "bugs": {
    "url": "https://github.com/AdmiralDS/date-picker/issues"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "AdmiralDS",
    "Admiral",
    "ui",
    "react",
    "library"
  ],
  "license": "See license in ./LICENSE",
  "sideEffects": [
    "**/*.css",
    "**/*.css.*"
  ],
  "publishConfig": {
    "access": "public"
  }
}
